{
    "id": "gobia-core",
    "name": "Gobia Core",
    "version": "1.0.0",
    "description": "Gobia branding, profile, appearance, access, server organization, admin overview and updates.",
    "author": "Gobia",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.4 <3.0",
        "php": "^8.3"
    },
    "provider": "GobiaCore\\GobiaCoreProvider",
    "autoload": {
        "GobiaCore\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "gb",
        "screens": [
            {
                "id": "profile",
                "area": "account",
                "path": "profile",
                "nav": {
                    "label": "Profile",
                    "icon": "user-round",
                    "order": 10
                }
            },
            {
                "id": "access",
                "area": "account",
                "path": "access",
                "nav": {
                    "label": "Access",
                    "icon": "users",
                    "order": 30
                }
            },
            {
                "id": "appearance",
                "area": "account",
                "path": "appearance",
                "nav": {
                    "label": "Appearance",
                    "icon": "palette",
                    "order": 90
                }
            },
            {
                "id": "updates",
                "area": "admin",
                "path": "updates",
                "nav": {
                    "label": "Updates",
                    "icon": "refresh-cw",
                    "order": 90
                }
            }
        ],
        "components": [
            "dashboard.page"
        ]
    }
}
